---
const procedures = [
  {
    number: "01",
    title: "Dental implants",
    body: "Permanent, natural-feeling tooth replacement.",
    href: "/services/replacing-missing-teeth/",
  },
  {
    number: "02",
    title: "Wisdom teeth",
    body: "Gentle removal with sedation options.",
    href: "/services/wisdom-teeth-removal/",
  },
  {
    number: "03",
    title: "Tooth extractions",
    body: "Routine and surgical extractions.",
    href: "/services/tooth-extractions/",
  },
  {
    number: "04",
    title: "Corrective jaw surgery",
    body: "Orthognathic care for function and balance.",
  },
  {
    number: "05",
    title: "Bone grafting",
    body: "Preparing your jaw for implants.",
    href: "/services/bone-grafting/",
  },
  {
    number: "06",
    title: "Oral pathology",
    body: "Diagnosis and treatment of oral lesions.",
    href: "/services/oral-pathology/",
  },
];
---

<section
  id="procedures"
  class="bg-aqua-soft text-foreground"
  aria-labelledby="procedures-heading"
>
  <div class="mx-auto max-w-7xl px-5 py-20 md:py-24 lg:px-0">
    <div class="text-center" data-reveal>
      <p class="text-xs font-bold tracking-[.34em] text-secondary">
        Procedures
      </p>
      <h2
        id="procedures-heading"
        class="serif mx-auto mt-4 max-w-4xl text-4xl leading-tight text-foreground sm:text-5xl"
      >
        A complete range of oral surgery
      </h2>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        procedures.map(({ number, title, body, href }, index) => (
          <article
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 80}ms`}
          >
            {href ? (
              <a
                href={href}
                class="group block h-full rounded-md bg-surface px-8 py-8 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-4 lg:h-[180px] lg:pb-6"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-sm font-bold text-surface">
                  {number}
                </div>
                <h3 class="serif mt-7 text-2xl leading-8 font-bold text-foreground transition-colors group-hover:text-secondary lg:mt-6 lg:text-[22px] lg:leading-7">
                  {title}
                </h3>
                <p class="mt-3 leading-7 text-muted lg:mt-2 lg:text-[15px] lg:leading-6">
                  {body}
                </p>
              </a>
            ) : (
              <div class="h-full rounded-md bg-surface px-8 py-8 shadow-sm lg:h-[180px] lg:pb-6">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-sm font-bold text-surface">
                  {number}
                </div>
                <h3 class="serif mt-7 text-2xl leading-8 font-bold text-foreground lg:mt-6 lg:text-[22px] lg:leading-7">
                  {title}
                </h3>
                <p class="mt-3 leading-7 text-muted lg:mt-2 lg:text-[15px] lg:leading-6">
                  {body}
                </p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
